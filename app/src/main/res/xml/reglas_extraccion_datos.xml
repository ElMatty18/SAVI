<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: no se copian datos a la nube ni a otro telefono. La sesion guardada tiene datos
     personales y se vuelve a obtener de Firebase al iniciar sesion. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
